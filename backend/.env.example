# Copie ce fichier en ".env" et remplis avec les vraies infos de votre Odoo
# NE JAMAIS committer le fichier .env réel sur Git (voir .gitignore)

# URL de base de ton Odoo, SANS le port et SANS /web à la fin
ODOO_URL=http://africanumerik.com

# Port utilisé par Odoo (8069 par défaut)
ODOO_PORT=8069

# Nom exact de la base de données Odoo
ODOO_DB=nom_de_la_base

# Login du compte technique utilisé pour les appels API
ODOO_USERNAME=technique@africanumerik.com

# Clé API générée dans Odoo (Préférences > Sécurité du compte > Clés API)
# ou le mot de passe du compte technique si pas de clé API générée
ODOO_API_KEY=colle_ta_cle_ici

# Port sur lequel CE backend (Node) va tourner
PORT=4000

# URL du frontend autorisée à appeler ce backend (pour la config CORS)
FRONTEND_URL=http://localhost:5173
